{
  "name": "breachpoint",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "MatchState": {
        "$className": "Folder"
      },
      "Remotes": {
        "KillFeed": { "$className": "RemoteEvent" },
        "MatchResults": { "$className": "RemoteEvent" },
        "LoadoutOffer": { "$className": "RemoteEvent" },
        "DraftPick": { "$className": "RemoteEvent" },
        "UseAbility": { "$className": "RemoteEvent" },
        "AbilityEffect": { "$className": "RemoteEvent" },
        "Interact": { "$className": "RemoteEvent" },
        "ObjectiveEvent": { "$className": "RemoteEvent" },
        "$className": "Folder",
        "Fire": { "$className": "RemoteEvent" },
        "Reload": { "$className": "RemoteEvent" },
        "ReloadStarted": { "$className": "RemoteEvent" },
        "Damaged": { "$className": "RemoteEvent" },
        "Melee": { "$className": "RemoteEvent" },
        "ShotFired": { "$className": "RemoteEvent" },
        "HitConfirmed": { "$className": "RemoteEvent" },
        "SetLean": { "$className": "RemoteEvent" },
        "SetCrouch": { "$className": "RemoteEvent" },
        "LookPitch": { "$className": "UnreliableRemoteEvent" },
        "DevAction": { "$className": "RemoteEvent" },
        "Destruction": { "$className": "RemoteEvent" },
        "PickSite": { "$className": "RemoteEvent" },
        "Drone": { "$className": "RemoteEvent" },
        "SetRappel": { "$className": "RemoteEvent" },
        "Vault": { "$className": "RemoteEvent" },
        "Queue": { "$className": "RemoteEvent" },
        "VoteMap": { "$className": "RemoteEvent" },
        "Cams": { "$className": "RemoteEvent" },
        "Settings": { "$className": "RemoteEvent" },
        "Shop": { "$className": "RemoteEvent" },
        "Progress": { "$className": "RemoteEvent" },
        "Party": { "$className": "RemoteEvent" },
        "Ping": { "$className": "RemoteEvent" },
        "Ranked": { "$className": "RemoteEvent" }
      }
    },

    "ReplicatedFirst": {
      "$path": "src/first"
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },

    "MaterialService": {
      "$className": "MaterialService",
      "GunFinishMetal": {
        "$className": "MaterialVariant",
        "$properties": {
          "BaseMaterial": "Metal",
          "ColorMap": "rbxassetid://90484103006937",
          "NormalMap": "rbxassetid://139166676751328",
          "MetalnessMap": "rbxassetid://123285428708776",
          "RoughnessMap": "rbxassetid://116931713188547",
          "StudsPerTile": 0.6
        }
      }
    },

    "Lighting": {
      "$properties": {
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "RbxCharacterSounds": {
          "$path": "src/RbxCharacterSounds.client.luau"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/Health.server.luau"
        },
        "Animate": {
          "$path": "src/Animate.client.luau"
        }
      }
    }
  }
}
