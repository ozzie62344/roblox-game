{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git reset:* --hard*)",
      "Bash(git:* --force*)",
      "Bash(git:* -f *)",
      "Bash(git:* -f)",
      "Bash(git push --force:*)",
      "Bash(git clean -f:*)",
      "Bash(git checkout -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git restore:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout:* -- *)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)"
    ]
  }
}
